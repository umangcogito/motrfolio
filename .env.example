# Motrfolio — environment variables
# Copy this file to `.env.local` and fill in real values. Never commit `.env.local`.

# ── Site ─────────────────────────────────────────────────────────────
# Public base URL (used for metadata / OG tags). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Postgres + Auth + Storage) ────────────────────────────
# Project URL and the *public* anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Bypasses RLS — never prefix with NEXT_PUBLIC_ and never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Claude API (listing copy generation, enquiry replies) ────────────
ANTHROPIC_API_KEY=sk-ant-your-key
# Optional model override (defaults set in code)
ANTHROPIC_MODEL=claude-opus-4-8

# ── OpenAI Whisper (voice note -> text) ──────────────────────────────
OPENAI_API_KEY=sk-your-openai-key

# ── Interakt (WhatsApp Business API) ─────────────────────────────────
INTERAKT_API_KEY=your-interakt-api-key
INTERAKT_BASE_URL=https://api.interakt.ai/v1

# ── Razorpay (subscriptions) — add when Phase 1 billing lands ─────────
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ── Image storage (Cloudflare R2) — add when uploads land ────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=motrfolio-listings
